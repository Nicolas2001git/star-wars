<section class="card">
  <h2>Saved Galactic Users</h2>

  {{#if error}}
    <p class="error">{{error}}</p>
  {{/if}}

  {{#if users.length}}
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Full Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Pets</th>
          <th>Encrypted Password</th>
        </tr>
      </thead>

      <tbody>
        {{#each users}}
          <tr>
            <td>{{this._id}}</td>
            <td>{{this.first_name}} {{this.last_name}}</td>
            <td>{{this.email}}</td>
            <td>{{this.role}}</td>
            <td>{{this.petsCount}}</td>
            <td>{{this.passwordPreview}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p>There are no saved users yet.</p>
  {{/if}}
</section>