<section class="card">
  <h2>Galactic Control Panel</h2>

  <p>
    Welcome, commander. From this control center, you can summon new travelers
    and creatures from across the galaxy. Choose how many records you want to
    generate and send them into the Galactic Registry.
  </p>

  <div class="form-box">
    <label for="users">Number of galactic travelers:</label>
    <input type="number" id="users" value="10" min="0">

    <label for="pets">Number of galactic creatures:</label>
    <input type="number" id="pets" value="20" min="0">

    <button id="generateButton">Launch Galactic Generation</button>
  </div>

  <div id="result" class="result hidden"></div>
</section>

<section class="card">
  <h2>Galactic Routes</h2>

  <p>
    Use these portals to explore the generated travelers, creatures, and registered
    data from your Star Wars universe.
  </p>

  <ul>
    <li><strong>Galactic Travelers:</strong> /mockingusers-view</li>
    <li><strong>Galactic Creatures:</strong> /mockingpets-view</li>
    <li><strong>Registered Travelers:</strong> /users-view</li>
    <li><strong>Registered Creatures:</strong> /pets-view</li>
  </ul>
</section>

<script>
  const button = document.getElementById("generateButton");
  const result = document.getElementById("result");

  button.addEventListener("click", async () => {
    const users = Number(document.getElementById("users").value);
    const pets = Number(document.getElementById("pets").value);

    result.classList.remove("hidden");
    result.innerHTML = "The Force is gathering your galactic data...";

    try {
      const response = await fetch("/api/mocks/generateData", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          users,
          pets
        })
      });

      const data = await response.json();

      if (data.status === "success") {
        result.innerHTML = `
          <p><strong>The Galactic Registry has been updated successfully.</strong></p>
          <p>Travelers summoned: ${data.payload.usersInserted}</p>
          <p>Creatures discovered: ${data.payload.petsInserted}</p>
          <a href="/users-view">View registered travelers</a>
          <a href="/pets-view">View registered creatures</a>
        `;
      } else {
        result.innerHTML = `
          <p class="error">${data.message}</p>
        `;
      }
    } catch (error) {
      result.innerHTML = `
        <p class="error">A disturbance in the Force occurred: ${error.message}</p>
      `;
    }
  });
</script>